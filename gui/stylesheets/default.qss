/* ==================== GENERAL ==================== */
QWidget {
    background-color:rgb(230, 230, 230);
    font-family: Arial, sans-serif;
    font-size: 14px;
    color: black;  /* ✅ Ajout pour éviter les contrastes faibles */
}

/* ==================== SEARCH BAR ==================== */
QLineEdit {
    padding: 8px;
    border: 2px solid #ccc;
    border-radius: 8px;
    font-size: 14px;
    background-color: white;
    color: black;
}
QLineEdit:focus {
    border: 2px solid #F29F05;
}

/* ==================== BUTTONS ==================== */
QPushButton {
    background-color: #F2B705;
    color: white;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    border: none;
    transition: background-color 0.3s;
}
QPushButton:hover {
    background-color: #F29F05;
}
QPushButton:pressed {
    background-color: #F2B705;
}

/* Icônes des boutons (pas de texte affiché) */
QPushButton {
    min-width: 30px;
    min-height: 30px;
}
#taskButton {
    border: #ffffff;
    background-color: #F2B705;
    min-width: 10px;
    min-height: 0px;
    border-radius: 5px;
}

#taskButton:hover {
    background-color: #F29F05;
}

/* ==================== TABLE ==================== */
QTableView {
    color: black;  /* ✅ Changement pour améliorer la lisibilité */
    background-color: white;
    gridline-color: #bbb;
    selection-background-color: #C2D7F2;
}
QHeaderView::section {
    background-color: #F2B705;
    color: white;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
    border: none;
}
QTableView::item {
    padding: 6px;
    font-size: 14px;
    border-bottom: 1px solid #ddd;
    color: black;  /* ✅ Assurer la visibilité du texte */
}
QTableView::item:selected {
    background-color: #C2D7F2;
    color: black;
}
QTableView::item[priority="High"] {
    color: red;
    font-weight: bold;
}

QTableView::item[priority="Medium"] {
    color: orange;
}

QTableView::item[priority="Low"] {
    color: green;
}

/* ==================== DIALOG ==================== */
QDialog {
    background-color: white;
    color: black;
}

QDialog QLabel {
    font-size: 14px;
    color: black;
}

QDialog QLineEdit, QDialog QComboBox {
    background-color: white;
    color: black;
    border: 1px solid gray;
}
