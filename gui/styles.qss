/* ==================== GENERAL ==================== */
QWidget {
    background-color: #f4f4f4;
    font-family: Arial, sans-serif;
    font-size: 14px;
}

/* ==================== SEARCH BAR ==================== */
QLineEdit {
    padding: 8px;
    border: 2px solid #ccc;
    border-radius: 8px;
    font-size: 14px;
    background-color: white;
    color: black;
}
QLineEdit:focus {
    border: 2px solid #0078D7;
}

/* ==================== BUTTONS ==================== */
QPushButton {
    background-color: #0078D7;
    color: white;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    border: none;
    transition: background-color 0.3s;
}
QPushButton:hover {
    background-color: #005bb5;
}
QPushButton:pressed {
    background-color: #003f7f;
}

/* Icônes des boutons (pas de texte affiché) */
QPushButton {
    min-width: 36px;
    min-height: 36px;
}

/* ==================== TABLE ==================== */
QTableWidget {
    background-color: white;
    border-radius: 8px;
    gridline-color: #ddd;
}
QHeaderView::section {
    background-color: #0078D7;
    color: white;
    padding: 6px;
    font-size: 14px;
    border: none;
}
QTableWidget::item {
    padding: 6px;
    font-size: 14px;
    border-bottom: 1px solid #ddd;
}
QTableWidget::item:selected {
    background-color: #cce7ff;
    color: black;
}
