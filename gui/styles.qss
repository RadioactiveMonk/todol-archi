/* ==================== GENERAL ==================== */
QWidget {
    background-color:rgb(230, 230, 230);
    font-family: Arial, sans-serif;
    font-size: 14px;
}

/* ==================== SEARCH BAR ==================== */
QLineEdit {
    padding: 8px;
    border: 2px solid #ccc;
    border-radius: 8px;
    font-size: 14px;
    background-color: white;
    color: black;
}
QLineEdit:focus {
    border: 2px solid #F29F05;
}

/* ==================== BUTTONS ==================== */
QPushButton {
    background-color: #F29F05;
    color: white;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    border: none;
    transition: background-color 0.3s;
}
QPushButton:hover {
    background-color: #F2B705;
}
QPushButton:pressed {
    background-color: #F29F05;
}

/* Icônes des boutons (pas de texte affiché) */
QPushButton {
    min-width: 36px;
    min-height: 36px;
}
#taskButton {
    border: #C2D7F2;
    background-color: transparent;
    min-width: 10px;
    min-height: 0px;
    border-radius: 5px;  /* ✅ Coins arrondis */
}

#taskButton:hover {
    background-color: #77B9F2;  /* ✅ Effet au survol */
}

/* ==================== TABLE ==================== */
QTableWidget {
    color: black;  /* ✅ Force la couleur du texte */
    background-color: white;  /* ✅ Évite un contraste invisible */
    gridline-color: #ccc;
    selection-background-color: #F29F05;  /* ✅ Améliore la sélection */
}
QHeaderView::section {
    background-color: #F2B705;
    color: white;
    padding: 6px;
    font-size: 14px;
    border: none;
}
QTableWidget::item {
    padding: 6px;
    font-size: 14px;
    border-bottom: 1px solid #ddd;
}
QTableWidget::item:selected {
    background-color: #C2D7F2;
    color: black;
}
