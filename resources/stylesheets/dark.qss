    QWidget {
        background-color: #2b2b2b;
        color: #ffffff;
        font-weight: bold;
        font-size: 14px;
        font: "Mona Sans";
    }
    QTableView {
        background-color: #333;
        alternate-background-color: #444;
        gridline-color: #555;
    }
    QHeaderView {
        background-color: #222;
        color: #ddd;
    }
    QTableView::item {
        background-color: #333;
        selection-background-color: #555;
        selection-color: #fff;
    }